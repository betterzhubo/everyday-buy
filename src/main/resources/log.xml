<configuration>

    <property name="logging.basepath" value="log"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="EVERYDAY_BUY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>${logging.basepath}/everyday_buy.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${logging.basepath}/everyday_buy.%d{yyyy-MM-dd}.log</fileNamePattern>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{yyyy/MM/dd-HH:mm:ss} [%thread] %-5level (%file:%line\) %logger- %msg%n
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="EVERYDAY_BUY" />
    </root>

</configuration>
